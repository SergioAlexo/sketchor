{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@sketchor/core": ["../../packages/core/src/index.ts"],
      "@sketchor/embed/three/*": ["../../packages/embed/src/three/*"]
    }
  },
  "include": ["src"]
}
