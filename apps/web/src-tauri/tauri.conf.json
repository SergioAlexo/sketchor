{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sketchor",
  "version": "0.33.1",
  "identifier": "com.sketchor.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sketchor",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRENTRBQjU1QTY4MDIwMUEKUldRYUlJQ21WYXRVVFJXTGFYT1NKSHVJK1NjWUowSDB4Q1IxZytRdGJaNk5IOVVmVURBS0x3WlcK",
      "endpoints": [
        "https://github.com/sergioalexo/sketchor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["dxf"],
        "name": "DXF Drawing",
        "description": "AutoCAD DXF drawing",
        "role": "Editor"
      },
      {
        "ext": ["svg"],
        "name": "SVG Drawing",
        "description": "SVG vector drawing",
        "role": "Viewer"
      },
      {
        "ext": ["eps"],
        "name": "EPS Drawing",
        "description": "Encapsulated PostScript drawing (import only)",
        "role": "Viewer"
      },
      {
        "ext": ["ai"],
        "name": "Illustrator Drawing",
        "description": "Adobe Illustrator drawing (import only)",
        "role": "Viewer"
      },
      {
        "ext": ["dwg"],
        "name": "DWG Drawing",
        "description": "AutoCAD DWG drawing (import only)",
        "role": "Viewer"
      },
      {
        "ext": ["step", "stp"],
        "name": "STEP Model",
        "description": "STEP 3D model (view only)",
        "role": "Viewer"
      },
      {
        "ext": ["iges", "igs"],
        "name": "IGES Model",
        "description": "IGES 3D model (view only)",
        "role": "Viewer"
      }
    ]
  }
}
