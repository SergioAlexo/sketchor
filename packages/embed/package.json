{
  "name": "@sketchor/embed",
  "version": "0.4.0",
  "description": "<sketchor-view> — drop-in animated preview of CAD files from Sketchor: orbitable 3D (glTF, GLB, STL, OBJ, PLY, 3MF) and 2D drawings (DXF, SVG, EPS, AI, PDF)",
  "license": "MIT",
  "author": "Sergio Alexo (https://sergioalexo.com)",
  "homepage": "https://sketchor.sergioalexo.com/embed",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergioAlexo/sketchor.git",
    "directory": "packages/embed"
  },
  "keywords": [
    "3d",
    "cad",
    "viewer",
    "web-component",
    "custom-element",
    "dxf",
    "svg",
    "gltf",
    "stl",
    "3mf",
    "embed",
    "three"
  ],
  "type": "module",
  "main": "dist/sketchor-embed.js",
  "module": "dist/sketchor-embed.js",
  "types": "types/sketchor-embed.d.ts",
  "exports": {
    ".": {
      "types": "./types/sketchor-embed.d.ts",
      "import": "./dist/sketchor-embed.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "dist/sketchor-embed.js",
  "jsdelivr": "dist/sketchor-embed.js",
  "sideEffects": [
    "./dist/sketchor-embed.js"
  ],
  "files": [
    "dist",
    "types",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "three": "^0.186.0"
  }
}
