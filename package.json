{
  "name": "sketchor",
  "private": true,
  "version": "0.33.0",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @sketchor/web",
    "build": "npm run build --workspace @sketchor/core && npm run build --workspace @sketchor/web",
    "desktop": "npm run tauri dev --workspace @sketchor/web",
    "test": "vitest run",
    "dxf:audit": "python tools/dxf-audit/audit.py",
    "dxf:scorecard": "vite-node tools/dxf-audit/scorecard.ts",
    "theme:schema": "node tools/gen-theme-schema.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^30.0.1",
    "vitest": "^2.1.9"
  }
}
